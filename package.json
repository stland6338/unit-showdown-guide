{
  "name": "unit-showdown-guide",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:data",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:data": "node scripts/check-data.mjs",
    "worker:dev": "wrangler dev -c wrangler-live.toml"
  },
  "dependencies": {
    "next": "^14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.30",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "workers-og": "^0.0.27",
    "wrangler": "^4.111.0"
  }
}
